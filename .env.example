# ── Seedwel / Billionaire Blueprint environment (all OPTIONAL) ─────────────
# Firebase is the TRUE database: Firestore holds the course catalog, user roles
# (users/{uid}.role — admins assigned from the admin console) and the Seedwel
# Certificate Incorporation registry ($5 issuance fee; tuition is free).
# Publish the repo's firestore.rules in the Firebase Console (or `firebase deploy
# --only firestore:rules`), then use Admin → Database Console → “Publish Curriculum
# to Firestore” once to seed the course database.
#
# Server
FIREBASE_PROJECT_ID=seedwel-cbeb8          # Firebase project whose ID tokens we verify
ADMIN_EMAILS=seedwell@seedwel.com,zacheus@seedwelinvestment.com   # extra admin emails (comma-separated)
DATABASE_URL=                              # Postgres connection (Vercel Postgres/Neon/Supabase)
KV_REST_API_URL=                           # Vercel KV (Upstash) — alternative to DATABASE_URL
KV_REST_API_TOKEN=
DEV_ADMIN_PASSWORD=122023                  # local/dev preview admin login (disabled in production)
# PORT=3001

# Frontend (fallbacks to the built-in seedwel-cbeb8 web config when unset)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
