# ── Seedwel / Billionaire Blueprint environment (all OPTIONAL but recommended for TRUE DB) ─────────────
# TRUE DATABASE = Firebase Firestore (primary) — course content, users (role field), progress, certificates $5 paid
# Server backup: Postgres / SQLite / Memory

# Server
FIREBASE_PROJECT_ID=seedwel-cbeb8          # Firebase project whose ID tokens we verify (Firestore true DB)
ADMIN_EMAILS=seedwell@seedwel.com,zacheus@seedwelinvestment.com   # extra admin emails (comma-separated) — will auto-promote to role=admin in Firestore users/{uid}
DATABASE_URL=                              # Postgres connection (Vercel Postgres/Neon/Supabase) — backup to Firestore
KV_REST_API_URL=                           # Vercel KV (Upstash) — alternative to DATABASE_URL
KV_REST_API_TOKEN=
# PORT=3001

# Certificate Business Model
# Tuition is FREE worldwide ($0)
# Certificate fee is $5 USD paid — verification + incorporation registry + anti-forgery
VITE_CERTIFICATE_FEE_USD=5
VITE_TUITION_MODEL=FREE
VITE_INCORPORATION_NOTE="Certificate Incorporation 2025 — No physical school built yet"

# Payments (replace mock with real in production)
# Stripe for $5 certificate fee
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal
VITE_PAYPAL_CLIENT_ID=
# Mobile Money (Zambia)
MOMO_API_KEY=

# Cloudinary — hosts the certificate PDFs (account dhad95cch, unsigned preset "seedwel")
# The upload preset "seedwel" is UNSIGNED so certificates upload straight from the browser;
# asset folder "samples/ecommerce" is set inside the preset.
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@dhad95cch   # server-side (optional, for signed operations)
VITE_CLOUDINARY_CLOUD_NAME=dhad95cch
VITE_CLOUDINARY_UPLOAD_PRESET=seedwel
VITE_CLOUDINARY_ASSET_FOLDER=samples/ecommerce

# Frontend Firebase (fallbacks to built-in seedwel-cbeb8 web config when unset — project is public ID)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=seedwel-cbeb8
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firestore Rules: see firestore.rules — tuition FREE (public read lessons), users/{uid} role controls admin, certificates $5 paid
